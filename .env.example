# Copier ce fichier en `.env` puis renseigner les 3 valeurs marquées À RENSEIGNER.
# `.env` ne doit jamais être versionné : la clé d'API reste sur votre poste.

# --- API compatible OpenAI (OpenAI, Azure, OpenRouter, Mistral, Ollama, LM Studio, vLLM...) ---
# URL de base de l'API. « /v1 » est ajouté automatiquement s'il manque.
OPENAI_API_URL=https://api.openai.com/v1
# À RENSEIGNER : la clé d'API (peut rester vide pour un serveur local sans authentification)
OPENAI_API_KEY=
# À RENSEIGNER : le nom exact du modèle chez ce fournisseur
OPENAI_MODEL=

# --- Réglages optionnels ---------------------------------------------------------------
# Délai maximal (secondes) d'UNE réponse du LLM.
# OPENAI_TIMEOUT=600
# Nombre de fichiers générés en parallèle (mettre 1 pour un petit serveur local).
# OPENAI_CONCURRENCY=2
# Température (non envoyée par défaut : certains modèles « raisonneurs » la refusent).
# OPENAI_TEMPERATURE=0.2
# Limite de tokens de sortie (non envoyée par défaut).
# OPENAI_MAX_TOKENS=8000
# Paramètres additionnels fusionnés dans chaque requête (JSON).
# OPENAI_EXTRA={"reasoning_effort": "low"}
# Nombre maximal de tours de correction d'un code qui ne compile pas.
# UMLFACTORY_MAX_REPAIRS=2
# Temps maximal (secondes) de la vérification d'exécution du code généré (compilation + test de fumée + conformité
# au diagramme). Au-delà, le code est signalé « non vérifié ». 0 : ne jamais exécuter le code généré.
# UMLFACTORY_VERIFY_TIMEOUT=10

# --- Adresses (tout tourne en local par défaut) ----------------------------------------
MCP_URL=http://127.0.0.1:9000/mcp
COORDINATOR_URL=http://127.0.0.1:9200
# Les agents de langage sont trouvés automatiquement sur cette plage de ports locaux
# (`python -m umlfactory.deploy` en lance un par fichier de umlfactory/generators/).
# GENERATOR_PORT_RANGE=9101-9150
# Agents supplémentaires hors de cette plage (autre machine...), séparés par des virgules.
# GENERATOR_AGENT_URLS=http://192.168.1.20:9101
